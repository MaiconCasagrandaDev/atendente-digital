// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  category    String
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@map("products")
}

enum OrderStatus {
  DRAFT            // carrinho sendo montado na conversa
  CONFIRMED        // cliente confirmou
  PREPARING        // na cozinha
  OUT_FOR_DELIVERY // saiu para entrega
  DELIVERED        // entregue
  CANCELED         // cancelado
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // wa_id do WhatsApp
  name      String?
  address   String?  // último endereço usado
  orders    Order[]
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Order {
  id            Int            @id @default(autoincrement())
  customerId    Int
  customer      Customer       @relation(fields: [customerId], references: [id])
  status        OrderStatus    @default(DRAFT)
  deliveryType  DeliveryType   @default(DELIVERY)
  address       String?
  paymentMethod PaymentMethod?
  changeFor     Decimal?       @db.Decimal(10, 2) // troco para quanto
  notes         String?
  total         Decimal        @default(0) @db.Decimal(10, 2)
  items         OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) // preço na hora do pedido
  notes     String? // ex.: "sem cebola"

  @@map("order_items")
}

enum MessageDirection {
  INBOUND  // cliente -> bot
  OUTBOUND // bot -> cliente
}

model Message {
  id          Int              @id @default(autoincrement())
  customerId  Int
  customer    Customer         @relation(fields: [customerId], references: [id])
  direction   MessageDirection
  waMessageId String?          @unique // id da Meta (wamid); evita salvar repetido
  text        String
  createdAt   DateTime         @default(now())

  @@index([customerId, createdAt])
  @@map("messages")
}