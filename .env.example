# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/atendente_digital?schema=public"

# Porta da API
PORT=3000

# Senha que você inventa e repete no painel da Meta, ao configurar o webhook
WHATSAPP_VERIFY_TOKEN="invente-uma-senha"

# "simulation" mostra as respostas no terminal; "live" envia pelo WhatsApp
WHATSAPP_MODE="simulation"
WHATSAPP_TOKEN="token-do-painel-da-meta"
WHATSAPP_PHONE_NUMBER_ID="id-do-numero-no-painel"
GRAPH_VERSION="v25.0"